# Copie para .env para rodar localmente.
# Em produção (Render) as variáveis vêm do render.yaml / dashboard.

PYTHON_ENV=dev

# Gere um valor forte (ex.: openssl rand -hex 32)
SECRET_KEY=changeme_super_secret

# Tempo de vida do access token (minutos)
ACCESS_TOKEN_EXPIRE_MINUTES=120

# PostgreSQL — aceite postgres:// ou postgresql://
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/rocketmail

# Banco usado pelo pytest (opcional; senão usa DATABASE_URL)
# DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/rocketmail_test

# SSL do Postgres: em production liga automaticamente.
# Localmente deixe 0. Force com DATABASE_SSL=1 se precisar.
DATABASE_SSL=0
# Certificado gerenciado do Render costuma falhar em verify-full.
DATABASE_SSL_VERIFY=0

# CORS: lista CSV. Em produção o backend também libera *.vercel.app via regex.
ALLOWED_ORIGINS=https://rocket-mail-site.vercel.app,http://localhost:8081,http://localhost:3000
ALLOWED_ORIGIN_REGEX=https://([\w-]+\.)*vercel\.app

# URL pública da API (prefixo dos uploads locais em dev)
PUBLIC_BASE_URL=http://localhost:8000

# Fotos de perfil — em PRODUÇÃO Cloudinary é obrigatório.
# Dashboard Cloudinary → API Keys → "API environment variable":
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=

# Em produção no Render: 1 para rodar migrate no start.
RUN_MIGRATIONS=0

# Limite de upload (default 5 MB = 5*1024*1024)
# FOTO_MAX_BYTES=5242880
